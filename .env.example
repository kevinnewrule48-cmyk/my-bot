# Use only after registering an OAuth application in Deriv.
# The redirect URL must match your Deriv registration exactly and must use HTTPS.
DERIV_CLIENT_ID=replace-with-your-client-id
DERIV_REDIRECT_URI=https://your-secure-domain.example/auth/callback
# Leave false for the demo-first version. Setting true enables the separate real-account confirmation flow.
ENABLE_REAL_TRADING=false
